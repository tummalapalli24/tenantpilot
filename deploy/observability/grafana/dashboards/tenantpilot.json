{
  "uid": "tenantpilot-agent-ops",
  "title": "TenantPilot - Agent operations",
  "tags": [
    "tenantpilot"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(agent_requests_total, tenant)",
          "refId": "tenant"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Agent success rate (15m)",
      "description": "Completed runs / all finished runs. Red below 90%, amber below 97%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agent_requests_total{status=\"completed\",tenant=~\"$tenant\"}[15m])) / clamp_min(sum(rate(agent_requests_total{tenant=~\"$tenant\"}[15m])), 1e-9)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds",
            "fixedColor": "#4f46e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#dc2626",
                "value": null
              },
              {
                "color": "#d97706",
                "value": 0.9
              },
              {
                "color": "#16a34a",
                "value": 0.97
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Agent latency p95 (15m)",
      "description": "Processing time per run segment (excludes time waiting for human approval).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_latency_seconds_bucket{tenant=~\"$tenant\"}[15m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#4f46e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4f46e5",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Agent requests / min",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agent_requests_total{tenant=~\"$tenant\"}[5m])) * 60"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": {
            "mode": "fixed",
            "fixedColor": "#4f46e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4f46e5",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Tool failures (1h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(tool_failures_total{tenant=~\"$tenant\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
