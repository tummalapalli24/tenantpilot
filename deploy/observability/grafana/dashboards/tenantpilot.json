      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(agent_latency_seconds_bucket{tenant=~\"$tenant\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_latency_seconds_bucket{tenant=~\"$tenant\"}[$__rate_interval])))",
          "legendFormat": "p95"
