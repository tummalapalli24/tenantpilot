              },
              {
                "color": "#d97706",
                "value": 1
              },
              {
                "color": "#dc2626",
                "value": 5
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Rate-limited requests (1h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(agent_rate_limited_total{tenant=~\"$tenant\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#4f46e5"
          },
          "thresholds": {
            "mode": "absolute",
