    {
      "type": "timeseries",
      "title": "Customer-system calls by outcome (/min, MCP server)",
      "description": "Includes retries: a burst of 5xx outcomes here with few tool failures means retries are absorbing flakiness.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
