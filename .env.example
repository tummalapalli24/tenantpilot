# Copy to .env for local development (`make api` etc. read it; docker compose passes the
# variables marked [compose] through from your shell / .env).

# --- LLM ------------------------------------------------------------------------------
# Leave empty to use the deterministic offline planner (offline-heuristic).
# With a key, switch a tenant to claude-opus-5 in the UI (Customer -> Overview -> Model).
ANTHROPIC_API_KEY=                                   # [compose]
DEFAULT_MODEL=claude-opus-5                          # [compose] model for newly created tenants

# --- Local dev infrastructure (docker compose up -d postgres redis) -------------------
DATABASE_URL=postgresql+asyncpg://tenantpilot_app:app-password@localhost:5432/tenantpilot
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://tenantpilot:owner-password@localhost:5432/tenantpilot
APP_DB_PASSWORD=app-password
REDIS_URL=redis://localhost:6379/0
MCP_SERVER_URL=http://localhost:8765/mcp
INGEST_MODE=queue            # 'inline' indexes uploads inside the API (no worker needed)

# --- Secrets: these defaults are for local development only ----------------------------
# Generate real ones for any shared environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=dev-only-change-me-jwt-secret-0123456789            # [compose]
SERVICE_TOKEN_SECRET=dev-only-change-me-service-secret-012345  # [compose]
SECRETS_MASTER_KEY=PYurpMu48p3iX6yK5vagOkVs3WWMybK74zq7_XJIOZM=          # [compose] example key generated for you

# --- Observability ---------------------------------------------------------------------
LOG_FORMAT=text                      # json in containers
OTEL_EXPORTER_OTLP_ENDPOINT=         # e.g. http://localhost:4318 with `make up-obs`
